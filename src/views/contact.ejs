<h1>Contact</h1><p class="lede">Have a project, question, or opportunity? Send a message and I’ll get back to you.</p><% errors.forEach(error => { %><p class="error"><%= error.msg %></p><% }) %><form class="form" method="post" action="/contact"><label>Name<input name="name" value="<%= values.name || currentUser?.displayName || '' %>" required></label><label>Email<input type="email" name="email" value="<%= values.email || currentUser?.email || '' %>" required></label><label>Message<textarea name="message" required minlength="10" maxlength="5000"><%= values.message || '' %></textarea></label><button class="button" type="submit">Send message</button></form>
