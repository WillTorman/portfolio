<p class="eyebrow">Private workspace</p><h1>Welcome, <%= currentUser.displayName %>.</h1><p>Your role: <strong><%= currentUser.role %></strong></p>
<section class="section"><h2>Your contact requests</h2><% if (!requests.length) { %><p>No requests yet.</p><% } %><% requests.forEach(request => { %><article class="card"><strong><%= request.status.replace('_', ' ') %></strong><p><%= request.message %></p><% if (request.response) { %><p><strong>Response:</strong> <%= request.response %></p><% } %></article><% }) %></section>
<% if (currentUser.role === 'admin') { %>
<section class="section"><h2>Add project</h2><form class="form" method="post" action="/dashboard/projects"><label>Title<input name="title" required></label><label>Summary<input name="summary" required></label><label>Description<textarea name="description" required></textarea></label><label>Technology<input name="technology" required></label><label>Project URL<input name="projectUrl" type="url"></label><label><input name="featured" type="checkbox"> Featured</label><button class="button" type="submit">Add project</button></form></section>
<section class="section"><h2>Manage projects</h2><% projects.forEach(project => { %><article class="card"><form class="form" method="post" action="/dashboard/projects/<%= project.id %>/update"><label>Title<input name="title" value="<%= project.title %>" required></label><label>Summary<input name="summary" value="<%= project.summary %>" required></label><label>Description<textarea name="description" required><%= project.description %></textarea></label><label>Technology<input name="technology" value="<%= project.technology %>" required></label><label>Project URL<input name="projectUrl" type="url" value="<%= project.project_url || '' %>"></label><label><input name="featured" type="checkbox" <%= project.featured ? 'checked' : '' %>> Featured</label><button class="button" type="submit">Save changes</button></form><form method="post" action="/dashboard/projects/<%= project.id %>/delete"><button class="link-button" type="submit">Delete project</button></form></article><% }) %></section>
<section class="section"><h2>Users</h2><table><tr><th>Name</th><th>Email</th><th>Role</th><th>Update</th></tr><% users.forEach(user => { %><tr><td><%= user.display_name %></td><td><%= user.email %></td><td colspan="2"><form class="inline" method="post" action="/dashboard/users/<%= user.id %>/role"><select name="role"><% ['admin', 'moderator', 'user'].forEach(role => { %><option value="<%= role %>" <%= user.role === role ? 'selected' : '' %>><%= role %></option><% }) %></select><button class="button" type="submit">Save</button></form></td></tr><% }) %></table></section>
<% } %>
<% if (currentUser.role === 'admin' || currentUser.role === 'moderator') { %><section class="section"><h2>Contact workflow</h2><p>Requests are received, assigned a status, and can be replied to or closed.</p><% requests.forEach(request => { %><article class="card"><p><strong><%= request.name %></strong> · <%= request.email %></p><p><%= request.message %></p><form class="form" method="post" action="/dashboard/requests/<%= request.id %>"><label>Status<select name="status"><% ['received', 'in_progress', 'replied', 'closed'].forEach(status => { %><option value="<%= status %>" <%= request.status === status ? 'selected' : '' %>><%= status.replace('_', ' ') %></option><% }) %></select></label><label>Response<textarea name="response"><%= request.response || '' %></textarea></label><button class="button" type="submit">Update request</button></form></article><% }) %></section><% } %>
