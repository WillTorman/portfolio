<p class="eyebrow"><%= project.technology %></p><h1><%= project.title %></h1><p class="lede"><%= project.summary %></p><p><%= project.description %></p>
<% if (project.project_url) { %><p><a class="button" href="<%= project.project_url %>">View project</a></p><% } %>
<section class="section"><h2>Discussion</h2><% if (currentUser) { %><form method="post" action="/projects/<%= project.slug %>/comments"><textarea name="body" required maxlength="2000" placeholder="Share your thoughts"></textarea><button class="button" type="submit">Post comment</button></form><% } else { %><p><a href="/login">Sign in</a> to leave a comment.</p><% } %><% comments.forEach(comment => { %><article class="comment"><strong><%= comment.display_name %></strong><small><%= new Date(comment.created_at).toLocaleDateString() %></small><p><%= comment.body %></p></article><% }) %></section>
