<h1>Sign in</h1><% errors.forEach(error => { %><p class="error"><%= error.msg %></p><% }) %><form class="form" method="post" action="/login"><label>Email<input type="email" name="email" value="<%= values.email || '' %>" required></label><label>Password<input type="password" name="password" required></label><button class="button" type="submit">Sign in</button></form><p>New here? <a href="/register">Create an account</a>.</p>
